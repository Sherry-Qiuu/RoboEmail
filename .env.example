# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=8787

# SQLite file, relative to apps/server
DB_PATH=data/roboemail.db

# Model provider. Only the OpenAI-compatible protocol is used,
# so any of these work by changing these three values.
# DeepSeek:  https://api.deepseek.com/v1
# WorkBuddy: (fill in after the open platform key is issued)
# Zhipu:     https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Leave empty to run on the built-in mock provider (no network, no cost).
# QUOTA_USER_PER_DAY=30
# QUOTA_TRIAL_PER_DAY=3

# Outbound mail. Leave SMTP_USER empty and verification codes are printed to the
# server log instead of being sent. 465 means implicit TLS, 587 means STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# MAIL_FROM defaults to "RoboEmail <SMTP_USER>". Only set it for a custom domain.
# MAIL_FROM="RoboEmail <no-reply@your-domain.com>"
# Outbound 465/587 blocked? Route through an HTTP proxy that supports CONNECT.
# SMTP_PROXY=http://127.0.0.1:7897
# SMTP_TIMEOUT_MS=15000

# Base URL used to build password-reset links.
APP_ORIGIN=http://localhost:5173
