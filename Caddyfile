# Reverse proxy and TLS in one file. Caddy fetches and renews the certificate
# automatically once the domain resolves to this machine.
#
# The domain must match APP_ORIGIN in .env, otherwise the reset link in the
# password mail points somewhere else.

rbem.online, www.rbem.online {
	encode zstd gzip

	# The API also serves the built frontend, so a single upstream is enough.
	reverse_proxy app:8787 {
		header_up X-Forwarded-For {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
